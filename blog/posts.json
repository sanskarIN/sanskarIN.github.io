---
layout: none
permalink: /blog/posts.json
sitemap: false
---
{%- comment -%}
  Every post, newest first, for the author pages (/blog/authors/?u=…).
{%- endcomment -%}
{%- assign owner_username = site.data.accounts.owner_username | default: "" | strip -%}
[
{%- for post in site.posts %}
  {%- assign minutes = post.content | strip_html | number_of_words | divided_by: 200 -%}
  {%- if minutes < 1 %}{% assign minutes = 1 %}{% endif %}
  {%- assign post_username = post.author_username | default: "" -%}
  {%- if post_username == "" and owner_username != "" -%}
    {%- unless post.author_login and post.author_login != site.author.username -%}
      {%- assign post_username = owner_username -%}
    {%- endunless -%}
  {%- endif %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date_to_xmlschema | jsonify }},
    "updated": {% if post.last_modified_at %}{{ post.last_modified_at | date_to_xmlschema | jsonify }}{% else %}null{% endif %},
    "description": {{ post.description | default: "" | jsonify }},
    "author": {{ post.author | default: site.author.name | jsonify }},
    "author_username": {{ post_username | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "tag_ids": [{% for tag in post.tags %}{% capture tag_id %}{% include tag-id.html tag=tag %}{% endcapture %}{{ tag_id | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}],
    "image": {% if post.image %}{{ post.image | relative_url | jsonify }}{% else %}null{% endif %},
    "reading_minutes": {{ minutes }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
