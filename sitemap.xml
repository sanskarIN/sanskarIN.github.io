---
layout: none
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- comment -%}
  Lists every HTML page, every blog post, and documents from any other
  output collection (for example future project pages in _projects/),
  except those with `sitemap: false` in their front matter. New pages and
  posts are added automatically. Policy pages, posts, and the Projects page
  (from its GitHub data) include the date they last changed.
{%- endcomment -%}
{%- assign sitemap_pages = site.html_pages | where_exp: "item", "item.sitemap != false" | sort: "url" -%}
{%- for item in sitemap_pages %}
  <url>
    <loc>{{ item.url | absolute_url | xml_escape }}</loc>
    {%- if item.policy %}
    <lastmod>{{ site.data.legal[item.policy] | date: "%Y-%m-%d" }}</lastmod>
    {%- elsif item.url == site.projects_url and site.data.github.generated_at %}
    <lastmod>{{ site.data.github.generated_at | date: "%Y-%m-%d" }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
{%- assign sitemap_posts = site.posts | where_exp: "item", "item.sitemap != false" -%}
{%- for item in sitemap_posts %}
  <url>
    <loc>{{ item.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ item.last_modified_at | default: item.date | date_to_xmlschema }}</lastmod>
  </url>
{%- endfor %}
{%- for collection in site.collections %}
  {%- if collection.output and collection.label != "posts" %}
    {%- assign collection_docs = collection.docs | where_exp: "item", "item.sitemap != false" %}
    {%- for item in collection_docs %}
  <url>
    <loc>{{ item.url | absolute_url | xml_escape }}</loc>
  </url>
    {%- endfor %}
  {%- endif %}
{%- endfor %}
</urlset>
