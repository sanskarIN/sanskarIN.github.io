---
layout: none
permalink: /manifest.webmanifest
sitemap: false
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.description | jsonify }},
  "id": {{ "/" | relative_url | jsonify }},
  "start_url": {{ "/" | relative_url | jsonify }},
  "scope": {{ "/" | relative_url | jsonify }},
  "display": "browser",
  "lang": {{ site.lang | jsonify }},
  "dir": "ltr",
  "background_color": {{ site.data.theme.light.bg | jsonify }},
  "theme_color": {{ site.data.theme.light.bg | jsonify }},
  "icons": [
    { "src": {{ "/assets/images/brand/icon-192.png" | relative_url | jsonify }}, "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": {{ "/assets/images/brand/icon-512.png" | relative_url | jsonify }}, "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": {{ "/assets/images/brand/icon-maskable-512.png" | relative_url | jsonify }}, "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": {{ "/assets/images/brand/favicon.svg" | relative_url | jsonify }}, "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
